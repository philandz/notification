# --- required ---
DATABASE_URL=mysql://philand:philand@127.0.0.1:3306/philand
JWT_SECRET=change-me
INTERNAL_SERVICE_TOKEN=change-me-long-random   # shared with producers calling Publish

# --- network ---
HTTP_HOST=0.0.0.0
HTTP_PORT=9109          # internal /health only
GRPC_HOST=0.0.0.0
GRPC_PORT=50109
CONSUL_ADDR=            # optional, best-effort registration

# --- tuning (defaults shown) ---
NOTIFICATION_READ_RETENTION_DAYS=90
NOTIFICATION_UNREAD_RETENTION_DAYS=180
NOTIFICATION_CLEANUP_INTERVAL_SECS=21600
NOTIFICATION_GROUP_WINDOW_SECS=900
RUST_LOG=info

# --- email (Phase 4, everything below is optional; OFF unless enabled AND a key is set) ---
NOTIFY_EMAIL_ENABLED=false
RESEND_API_KEY=                     # Resend API key (put it in the secret store, not in git)
MAIL_FROM_ADDRESS=Philandz <noreply@philandz.com>   # NOTIFY_MAIL_FROM_ADDRESS overrides it
APP_PUBLIC_BASE_URL=http://localhost:3000           # origin used for links in emails
NOTIFY_PUBLIC_API_BASE_URL=         # where /api/notification/unsubscribe is reachable (default: APP_PUBLIC_BASE_URL)
SUPPORT_EMAIL=support@philandz.com
IDENTITY_GRPC_URL=http://127.0.0.1:50051            # contact lookup (email + locale)
NOTIFY_EMAIL_DAILY_CAP=3            # max emails per user per 24h (security is exempt)
NOTIFY_EMAIL_MAX_ATTEMPTS=6
NOTIFY_EMAIL_INTERVAL_SECS=10
NOTIFY_EMAIL_BATCH_SIZE=20
NOTIFY_UNSUBSCRIBE_SECRET=          # HMAC key for unsubscribe links (default: INTERNAL_SERVICE_TOKEN)
